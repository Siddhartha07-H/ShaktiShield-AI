# ==============================================================================
# SHAKTISHIELD AI BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' in this directory (backend/.env) before running:
# cp .env.example .env
#
# IMPORTANT:
# - Never commit the actual '.env' file containing secrets to version control.
# - 'backend/.env' is explicitly ignored by .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase PostgreSQL / Local SQLite Fallback)
# ------------------------------------------------------------------------------
# SUPABASE POSTGRESQL (RECOMMENDED FOR PRODUCTION):
# In your Supabase Dashboard: Project Settings -> Database -> Connection String -> URI
# Replace [YOUR-PASSWORD] with your actual database password.
#
# Option A: Direct Connection (Port 5432)
# DATABASE_URL="postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
#
# Option B: Transaction Pooler / PgBouncer (Port 6543 - ideal for serverless / Vercel):
# DATABASE_URL="postgresql+psycopg2://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"
#
# Option C: Local SQLite Fallback (Used automatically if DATABASE_URL is left unset):
DATABASE_URL="sqlite:///./shaktishield.db"

# ------------------------------------------------------------------------------
# 2. SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate a secure 64-character hex key in terminal: openssl rand -hex 32
JWT_SECRET="shaktishield-replace-with-openssl-rand-hex-32-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 3. APPLICATION & OPERATIONAL FLAGS
# ------------------------------------------------------------------------------
PROJECT_NAME="SHAKTISHIELD AI"
PROJECT_VERSION="1.0.0"
DEMO_MODE=True

# ------------------------------------------------------------------------------
# 4. CORS ORIGINS (Comma-separated or list of allowed origins)
# ------------------------------------------------------------------------------
# BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://localhost:3000"]'

# ------------------------------------------------------------------------------
# 5. THIRD-PARTY NOTIFICATIONS (Optional - Set True ONLY when credentials configured)
# ------------------------------------------------------------------------------
SMS_PROVIDER_CONFIGURED=False
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

EMAIL_PROVIDER_CONFIGURED=False
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# ------------------------------------------------------------------------------
# 6. BLOCKCHAIN INTEGRITY ANCHOR (Modular Testnet Layer)
# ------------------------------------------------------------------------------
BLOCKCHAIN_NETWORK="Polygon Amoy Testnet (Modular Ready)"
WEB3_PROVIDER_URI=""
REGISTRY_CONTRACT_ADDRESS=""
