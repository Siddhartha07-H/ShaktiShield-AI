# ==========================================
# SHAKTISHIELD AI - Environment Configuration
# ==========================================

# 1. APPLICATION & CORE
PROJECT_NAME="SHAKTISHIELD AI"
DEMO_MODE=True

# 2. SECURITY & AUTHENTICATION
# Generate a strong 64-char key in production: openssl rand -hex 32
JWT_SECRET="shaktishield-production-secure-key-replace-with-openssl-rand-hex-32"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. DATABASE CONFIGURATION
# Local Development (SQLite):
DATABASE_URL="sqlite:///./shaktishield.db"

# Production Supabase PostgreSQL:
# Format: postgresql+psycopg2://postgres:[YOUR-PASSWORD]@[YOUR-SUPABASE-HOST]:5432/postgres
# DATABASE_URL="postgresql+psycopg2://postgres:YOUR_PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# 4. FRONTEND CONFIGURATION
# Set in frontend/.env or Vercel dashboard:
# VITE_API_URL="https://your-backend.vercel.app"

# 5. THIRD-PARTY TELECOM (Optional - Set True only if credentials configured)
SMS_PROVIDER_CONFIGURED=False
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# 6. EMAIL PROVIDER (Optional - Set True only if SMTP credentials configured)
EMAIL_PROVIDER_CONFIGURED=False
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# 7. MODULAR BLOCKCHAIN ANCHOR (Testnet / Simulated)
BLOCKCHAIN_NETWORK="Polygon Amoy Testnet (Modular Ready)"
WEB3_PROVIDER_URI=""
REGISTRY_CONTRACT_ADDRESS=""
